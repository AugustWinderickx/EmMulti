// ===========================================================================
// multiome-wnn-nf configuration
// ===========================================================================

workDir = '/lustre1/scratch/359/vsc35918/nextflow-work'

trace.overwrite    = true
report.overwrite   = true
timeline.overwrite = true
dag.overwrite       = true

params {
    // --- input / output ---
    samplesheet          = null
    outdir               = 'results'
    markers              = "${projectDir}/assets/markers.yaml"
    help                 = false

    // --- genome / species ---
    genome               = 'hg38'      // hg38 | mm10
    species              = 'human'     // human | mouse
    // GTF used to fill in gene symbols for RNA inputs whose var_names are
    // Ensembl IDs (some external .h5ad releases) -- set per-cluster below,
    // or override on the CLI with --gtf
    gtf                  = null

    // --- barcode handling ---
    // strip trailing -<n> (e.g. -1) so RNA and ATAC barcodes match
    strip_barcode_suffix = true

    // --- ATAC import ---
    min_num_fragments    = 1000
    tile_size            = 5000

    // --- automatic TSSe thresholding ("the dip") ---
    tsse_mode            = 'per_sample'  // per_sample | global | manual
    tsse_manual_threshold = null         // fixed threshold; required if tsse_mode == manual
    default_min_tsse     = 5.0           // fallback if not bimodal
    tsse_min_high_peak   = 4.0           // high-quality mode must sit above this
    tsse_clamp_lo        = 2.0           // never threshold below this
    tsse_clamp_hi        = 10.0          // never threshold above this

    // --- ATAC embedding ---
    atac_n_features      = 50000
    atac_n_comps         = 30

    // --- RNA QC / embedding ---
    rna_min_genes        = 100
    rna_min_cells        = 3
    rna_max_pct_mt       = null          // e.g. 20 to hard-cap; null = keep all
    rna_qc_mode          = 'basic'       // basic | strict (adds MAD-outlier filtering)
    rna_strict_n_mads    = 5.0           // strict: MAD threshold, counts/genes/top20
    rna_strict_mt_n_mads = 3.0           // strict: MAD threshold, pct_counts_mt
    rna_strict_max_pct_mt = 8.0          // strict: hard mito cap
    rna_n_top_genes      = 3000
    rna_n_pcs            = 50

    // --- WNN ---
    rna_rep              = 'X_pca_harmony'
    atac_rep             = 'X_spectral_harmony'
    wnn_n_neighbors      = 50
    wnn_n_multineighbors = 50

    // --- batch-correction comparison ---
    // also run WNN/annotation/plots on the uncorrected embeddings, in parallel
    // with the Harmony-corrected branch, so the two can be compared side by side
    compare_batch_correction = true
    rna_rep_raw          = 'X_pca'
    atac_rep_raw         = 'X_spectral'

    // --- annotation ---
    leiden_resolutions   = '0.1,0.2,0.5'
    primary_resolution   = 0.2

    // --- conda envs (override per-cluster in conf/vsc.config) ---
    atac_env             = 'snapatac2_jan26'
    rna_env              = 'scrna_nov25'
    muon_env             = 'muon_apr26'

    // --- SLURM (used by the vsc profile) ---
    slurm_account        = null          // e.g. lp_big_wice_gpu_h100 or a CPU credit account
    slurm_cluster        = 'wice'

    // --- ATAC<->RNA barcode matching (10x Multiome) ---
    // 'auto': per sample, try translation only where direct barcode matching
    //   is poor (< min_overlap_frac); a sample is only actually switched to
    //   the translated barcodes if that beats direct AND clears
    //   barcode_pairing_min_fold over the chance-level expectation -- some
    //   samples in a mixed cohort are separate, unpaired snRNA/snATAC
    //   captures on the same tissue block, not true multiome, and no amount
    //   of barcode translation makes those cell-paired (see wnn_integrate.py
    //   docstring for the Hickey/HuBMAP numbers this was validated against).
    // 'force': always attempt translation. 'skip': legacy, direct match only.
    barcode_translation        = 'auto'
    // min fold-enrichment of post-translation overlap over the chance-level
    // expectation (two random barcode sets of that size from the ~736k
    // whitelist) to call a sample genuinely cell-paired
    barcode_pairing_min_fold   = 5.0
    atac_to_gex_translation    = "${projectDir}/assets/arc_whitelists/atac_to_gex_translation.tsv.gz"
}

// resource labels
includeConfig 'conf/base.config'

profiles {
    standard { process.executor = 'local' }

    conda {
        conda.enabled = true
        conda.useMamba = true
    }

    vsc {
        includeConfig 'conf/vsc.config'
    }

    test {
        params.samplesheet = "${projectDir}/assets/samplesheet_example.csv"
        process.executor = 'local'
    }
}

// provenance
timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline.html" }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report.html" }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace.txt" }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/dag.html" }

manifest {
    name = 'multiome-wnn-nf'
    description = 'snRNA + snATAC WNN broad cell-type annotation (CRC / gut)'
    mainScript = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version = '0.1.0'
}
