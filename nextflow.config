// ===========================================================================
// multiome-wnn-nf configuration
// ===========================================================================

params {
    // --- input / output ---
    samplesheet          = null
    outdir               = 'results'
    markers              = "${projectDir}/assets/markers.yaml"
    help                 = false

    // --- genome / species ---
    genome               = 'hg38'      // hg38 | mm10
    species              = 'human'     // human | mouse

    // --- barcode handling ---
    // strip trailing -<n> (e.g. -1) so RNA and ATAC barcodes match
    strip_barcode_suffix = true

    // --- ATAC import ---
    min_num_fragments    = 1000
    tile_size            = 5000

    // --- automatic TSSe thresholding ("the dip") ---
    tsse_mode            = 'per_sample'  // per_sample | global
    default_min_tsse     = 5.0           // fallback if not bimodal
    tsse_min_high_peak   = 4.0           // high-quality mode must sit above this
    tsse_clamp_lo        = 2.0           // never threshold below this
    tsse_clamp_hi        = 10.0          // never threshold above this

    // --- ATAC embedding ---
    atac_n_features      = 50000
    atac_n_comps         = 30

    // --- RNA QC / embedding ---
    rna_min_genes        = 100
    rna_min_cells        = 3
    rna_max_pct_mt       = null          // e.g. 20 to hard-cap; null = keep all
    rna_n_top_genes      = 3000
    rna_n_pcs            = 50

    // --- WNN ---
    rna_rep              = 'X_pca_harmony'
    atac_rep             = 'X_spectral_harmony'
    wnn_n_neighbors      = 50
    wnn_n_multineighbors = 50

    // --- annotation ---
    leiden_resolutions   = '0.1,0.2,0.5'
    primary_resolution   = 0.2

    // --- conda envs (override per-cluster in conf/vsc.config) ---
    atac_env             = 'snapatac2_jan26'
    rna_env              = 'scrna_nov25'
    muon_env             = 'muon_apr26'

    // --- SLURM (used by the vsc profile) ---
    slurm_account        = null          // e.g. lp_big_wice_gpu_h100 or a CPU credit account
    slurm_cluster        = 'wice'
}

// resource labels
includeConfig 'conf/base.config'

profiles {
    standard { process.executor = 'local' }

    conda {
        conda.enabled = true
        conda.useMamba = true
    }

    vsc {
        includeConfig 'conf/vsc.config'
    }

    test {
        params.samplesheet = "${projectDir}/assets/samplesheet_example.csv"
        process.executor = 'local'
    }
}

// provenance
timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline.html" }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report.html" }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace.txt" }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/dag.html" }

manifest {
    name = 'multiome-wnn-nf'
    description = 'snRNA + snATAC WNN broad cell-type annotation (CRC / gut)'
    mainScript = 'main.nf'
    nextflowVersion = '>=23.10.0'
    version = '0.1.0'
}
