// KU Leuven VSC (wice) SLURM profile.
//
// Notes:
//  * VSC is credit-accounted: pass your account with --slurm_account. CPU and
//    GPU work usually draw on *different* credit accounts, so if you later add
//    a GPU step, give it its own account via a withLabel override below.
//  * This pipeline is CPU-bound (SnapATAC2 spectral, Harmony, scrublet, Leiden
//    are all CPU); no GPU partition is requested by default.
//  * Conda envs are activated per process. Point atac_env/rna_env/muon_env at
//    your named envs (defaults: snapatac2_jan26 / scrna_nov25 / muon_apr26) or
//    at absolute env prefixes.
conda.enabled  = true
conda.useMamba = true

params {
    atac_env = '/lustre1/project/stg_00002/lcb/awinderickx/envs/snapatac2_jan26'
    rna_env  = '/lustre1/project/stg_00002/lcb/awinderickx/envs/scrna_nov25'
    muon_env = '/lustre1/project/stg_00002/lcb/awinderickx/envs/muon_apr26'

    // CLI-overridable; undefined params resolve to null in Nextflow, so ?: works.
    slurm_account   = params.slurm_account   ?: 'lp_big_wice_cpu'
    slurm_cluster   = params.slurm_cluster   ?: 'wice'
    slurm_partition = params.slurm_partition ?: 'dedicated_big_bigmem'
    slurm_qos       = params.slurm_qos       ?: null
}

process {
    executor       = 'slurm'
    // SLURM job scripts run non-interactively, so ~/.bashrc's conda-init block
    // (guarded by `case $- in *i*) ;; *) return ;; esac`) never runs and `conda`
    // is not on PATH. Source conda.sh directly so Nextflow's own
    // `conda info --json` / `source .../bin/activate <env>` wrapper works.
    beforeScript   = 'source /lustre1/project/stg_00002/mambaforge/vsc35918/etc/profile.d/conda.sh'
    clusterOptions = {
        def o = "--account=${params.slurm_account} --clusters=${params.slurm_cluster}"
        if (params.slurm_qos) o += " --qos=${params.slurm_qos}"
        return o
    }
    queue = params.slurm_partition   // wice CPU partition; change via --slurm_partition if needed

    // SnapATAC2 + scanpy + muon WNN step, 17 samples: bin/fragment matrices are
    // sparse/backed, so this stays well under bigmem territory. Bump if your
    // per-sample cell/bin counts run higher than typical.
    withLabel: process_wnn {
        cpus   = 8
        memory = '128.GB'
        time   = '6h'
    }

    // If you add a GPU process later, give it e.g.:
    // withLabel: process_gpu {
    //     queue = 'gpu_h100'
    //     clusterOptions = { "--account=lp_big_wice_gpu_h100 --clusters=wice --gpus-per-node=1" }
    // }
}

executor {
    queueSize       = 30       // concurrent SLURM jobs
    submitRateLimit = '10/1min'
}

// Keep Nextflow's own scratch on the fast filesystem; set NXF_WORK when running:
//   export NXF_WORK=$VSC_SCRATCH/nf-work