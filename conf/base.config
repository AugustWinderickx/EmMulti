// Resource labels. Memory scales on retry so a single OOM sample doesn't kill
// the run. Tune the ceilings to your cluster's node sizes.

process {
    errorStrategy = { task.exitStatus in [104,134,137,139,140,143,247] ? 'retry' : 'finish' }
    maxRetries    = 2

    cpus   = 1
    memory = { 8.GB  * task.attempt }
    time   = { 2.h   * task.attempt }

    withLabel: process_low {
        cpus   = 2
        memory = { 12.GB * task.attempt }
        time   = { 3.h   * task.attempt }
    }
    withLabel: process_medium {
        cpus   = 8
        memory = { 48.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }
    withLabel: process_high {
        // ATAC embed / RNA embed / WNN — memory-hungry on large cohorts
        cpus   = 16
        memory = { 120.GB * task.attempt }
        time   = { 24.h   * task.attempt }
    }
}
